package-as: LibDataGrid-1.0

# LibStub and CallbackHandler-1.0 are fetched at package time and never committed, pinned to the
# commit of an Ace3 release (Release-r1403) on its GitHub mirror. tests/libs.lua reads this block
# and fetches the same commit into Libs/ for the tests. CallbackHandler is only for the view's
# CallbackHandler events adapter; an addon embedding lib.xml brings its own copy if it uses that.
externals:
  Libs/LibStub:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: d295b12f8b889a30e86e0e901c5494df4b149c49
    path: LibStub
  Libs/CallbackHandler-1.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: d295b12f8b889a30e86e0e901c5494df4b149c49
    path: CallbackHandler-1.0

ignore:
  - annotations
  - coverage
  - docs
  - tests
  - libdatagrid-dev-1.rockspec
  - stylua.toml
